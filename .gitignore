# simple-workflow plugin artifacts (local-only; delete entries to share via git)
.simple-workflow/
.simple-workflow

# Gradle / Android build output
.gradle/
.kotlin/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties
*.iml
.idea/
.cxx/
captures/
*.hprof

# Private signing material. The PUBLIC dev key in signing/dev/ is committed on purpose (see signing/README.md).
keystore.properties
*.jks
*.keystore
!signing/dev/*.jks
*.p12
*.pem
.env
.env.*

# Local scratch + logs
/scratch/
*.log
__pycache__/
.DS_Store

# APKs are built by GitHub Actions and published as Release assets: never commit one (GitHub rejects files over 100 MB)
dist/
*.apk
*.aab
